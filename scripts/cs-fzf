#!/usr/bin/env bash
#
# Realtime search over the chat archive, using fzf purely as a renderer.
#
# A stopgap for evaluating ranking, not the eventual UI. fzf normally filters a fixed
# list itself; `--disabled` turns that off and `change:reload` re-runs `cs search` on
# every keystroke instead, so the ranking stays ours and fzf only draws.
#
# This script **prints the resume command on stdout and does nothing else**. It does not
# run the agent itself, because handing a full-screen TUI a correct terminal across an
# exec is fragile — fzf's own stdin is a pipe, and both `become` and a plain `exec` have
# been observed leaving Claude Code unable to read keystrokes and Codex panicking in
# crossterm with "reader source not set". Letting your own interactive shell run the
# command sidesteps the whole class of problem: the agent is then an ordinary child of an
# ordinary shell, with the terminal it expects.
#
#   source scripts/cs-fzf.sh && csf   # best: your own shell runs it, and it lands in history
#   scripts/cs-fzf --run              # launch directly, exec'ing with no shell in between
#   eval "$(scripts/cs-fzf)"          # equivalent to csf, without sourcing anything
#   scripts/cs-fzf                    # just print the command
#   scripts/cs-fzf --debug            # report terminal state, for diagnosing the above
#
# ChatGPT conversations resume via a URL rather than a command, so those rows are emitted
# as `open "<url>"` — otherwise 69% of this corpus is neither runnable nor eval-safe.
#
# Requires fzf and jq. Set CS_BIN to point at a specific `cs`; CS_FZF_LIMIT to change
# how many conversations are listed (default 200).
set -uo pipefail

CS="${CS_BIN:-cs}"
# Warm cost at this limit is ~5 ms typical and ~80 ms for a pathologically broad prefix
# like "the". Raising it to 1000 roughly doubles the broad case, for rows nobody scrolls to.
LIMIT="${CS_FZF_LIMIT:-200}"
case "$(uname -s)" in
  Darwin) OPENER="${CS_FZF_OPENER:-open}" ;;
  *)      OPENER="${CS_FZF_OPENER:-xdg-open}" ;;
esac
export OPENER

# One line per conversation: resume command, TAB, what the user sees. fzf hides field 1
# with --with-nth, so the command rides along with the row without being displayed.
#
# `ended_date` is already the local day, rendered by cs-core alongside the raw `ended_at`.
# This used to re-derive it here with strflocaltime because `cs`'s own formatter counted UTC
# days and named tomorrow for anything logged after ~17:00 local; the rule now lives in one
# place, so this client only prints what it is given.
fmt() {
  "$CS" search "$1" --prefix --limit "$LIMIT" --json 2>/dev/null | jq -r --arg opener "$OPENER" '
    .results[]? |
    (.ended_date // "????-??-??") as $date |
    (.hits[0].snippet // "") as $snippet |
    # ChatGPT conversations resume via a URL, not a command — 69% of this corpus. Left raw
    # they are neither runnable nor eval-safe, so they become an explicit open command here.
    ((.resume_cmd // "") | if startswith("http") then "\($opener) \"\(.)\"" else . end) as $cmd |
    [ $cmd,
      "\(.title // "(untitled)")",
      "\(.source)  \($date)  \(.user_turns)t",
      $snippet,
      # Field 5 is hidden like field 1. It exists so the selection can be recorded against
      # the query that produced it, which is the only ground truth the ranking ever gets
      # without somebody sitting down to grade results by hand.
      .conv_id
    ] | @tsv'
}

# fzf runs bindings through $SHELL, which will not have our functions defined, so the
# script re-invokes itself by path rather than exporting `fmt`.
if [[ "${1:-}" == "--reload" ]]; then fmt "${2:-}"; exit 0; fi
if [[ "${1:-}" == "--run" ]]; then RUN=1; shift; fi

if [[ "${1:-}" == "--debug" ]]; then
  { echo "cs-fzf --debug"
    echo "  \$SHELL      : ${SHELL:-unset}"
    echo "  cs          : $(command -v "$CS" 2>/dev/null || echo "NOT FOUND ($CS)")"
    echo "  cs search   : $("$CS" search --help >/dev/null 2>&1 && echo present || echo MISSING)"
    echo "  fzf         : $(command -v fzf >/dev/null && fzf --version || echo MISSING)"
    echo "  jq          : $(command -v jq >/dev/null && jq --version || echo MISSING)"
    echo "  tty         : $(tty 2>&1)"
    for fd in 0 1 2; do
      [ -t "$fd" ] && echo "  fd$fd         : tty" || echo "  fd$fd         : NOT a tty"
    done
    # The redirect failure is reported by the shell itself, so the suppression has to wrap
    # the whole construct rather than sit on the `exec`.
    if { exec 9<>/dev/tty; } 2>/dev/null; then echo "  /dev/tty rw : OK"; exec 9<&-
    else echo "  /dev/tty rw : FAILED — this is what breaks agent input"; fi
    echo "  rows for '' : $(fmt "" | wc -l | tr -d ' ')"
  } >&2
  exit 0
fi

command -v fzf >/dev/null || { echo "cs-fzf: needs fzf (brew install fzf)" >&2; exit 1; }
command -v jq  >/dev/null || { echo "cs-fzf: needs jq (brew install jq)"  >&2; exit 1; }
# Probing `search` specifically, not `--version`: an older installed `cs` answers --version
# perfectly well and then has no search subcommand, which would show up as a silently empty
# list rather than an error.
"$CS" search --help >/dev/null 2>&1 || {
  echo "cs-fzf: '$CS' has no 'search' subcommand — stale binary?" >&2
  echo "        cargo install --path crates/cs   (or set CS_BIN=target/release/cs)" >&2
  exit 1
}

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
export CS_BIN="$CS" CS_FZF_LIMIT="$LIMIT"

# fzf draws on /dev/tty when its stdout is captured, so the UI still works inside $( ).
# An empty query lands on `cs`'s recent-conversations path, so the list is populated
# before the first keystroke rather than opening blank.
out="$(
  fmt "" | fzf \
    --print-query \
    --disabled --no-sort --reverse --height=90% --border \
    --delimiter=$'\t' --with-nth='2,3' \
    --prompt='chat ▸ ' \
    --header=$'enter: pick  ·  ctrl-y: copy command  ·  ctrl-/: preview' \
    --preview='printf "%s\n\n%s\n" {2} {4}' \
    --preview-window='down,4,wrap' \
    --bind "change:reload($SELF --reload {q})" \
    --bind 'ctrl-/:toggle-preview' \
    --bind 'ctrl-y:execute-silent(printf %s {1} | pbcopy)+abort'
)" || exit 0

# `--print-query` puts the query buffer on the first line, so a run that was aborted without
# picking anything is exactly one line long. Split with parameter expansion rather than
# mapfile, which needs bash 4 and macOS still ships 3.2 as /bin/bash.
query="${out%%$'\n'*}"
choice="${out#*$'\n'}"
[[ "$choice" == "$query" ]] && exit 0

cmd="${choice%%$'\t'*}"
[[ -z "$cmd" ]] && exit 0
# Field 5, last on the row and hidden from the display. Recording which conversation won a
# given query is what turns everyday use into eval data — see `cs needs`. Never allowed to
# break the pick: the point of the tool is to open the conversation.
conv_id="${choice##*$'\t'}"
if [[ -n "$conv_id" && "$conv_id" != "$choice" ]]; then
  "$CS" pick "$conv_id" --query "$query" --quiet >/dev/null 2>&1 || true
fi

if [[ -n "${RUN:-}" ]]; then
  printf '\033[2m%s\033[0m\n' "$cmd" >&2
  # Split into argv and exec directly, with no shell in between. `$SHELL -lc` would work
  # too, but a login shell re-sources the whole rc chain first, and anything in there that
  # touches the terminal lands between fzf and the agent — which is one candidate for why
  # exec'ing through a shell misbehaved. A URL was already rewritten to `open "<url>"` by
  # `fmt`, so eval is still needed for the quoting in that one case.
  if [[ "$cmd" == "$OPENER "* ]]; then
    exec /bin/sh -c "$cmd" < /dev/tty
  fi
  read -ra argv <<< "$cmd"
  exec "${argv[@]}" < /dev/tty
fi

# stdout carries the command and nothing else, so `eval "$(cs-fzf)"` is safe.
printf '%s\n' "$cmd"
